# Base URL of the stock PocketBase instance the plugin writes to.
# All requests are ${VITE_API_URL}/api/collections/{name}/records
# Local dev (matches the frontend's default):
VITE_API_URL=http://localhost:8090

# Web app origin used for Microsoft OAuth (/oauth/start) and share links.
# Defaults to VITE_API_URL (SPA is usually served from the same host via pb_public).
# When running the Vite frontend separately in dev, point at that origin:
# VITE_APP_URL=http://localhost:5173
# VITE_APP_URL=http://localhost:8090

# Production example — remember to also add the origins to
# manifest.json → networkAccess.allowedDomains:
# VITE_API_URL=https://your-pocketbase-host
# VITE_APP_URL=https://your-pocketbase-host
