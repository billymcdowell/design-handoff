{
  "name": "design-handoff-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local MCP server that pulls design-handoff frame specs from PocketBase",
  "bin": {
    "design-handoff-mcp": "./dist/index.js"
  },
