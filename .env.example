# Optional. Docker Compose works with zero config — defaults to port 8090.
#
#   docker compose up -d --build
#
# On first boot, create the admin via the installer URL in the logs
# (replace 0.0.0.0 with localhost):
#
#   docker compose logs | grep pbinstall
#
# Only set the vars below if you want to skip that installer (CI / automation).

# PORT=8090
# PB_SUPERUSER_EMAIL=admin@example.com
# PB_SUPERUSER_PASSWORD=change-me-to-a-long-password
